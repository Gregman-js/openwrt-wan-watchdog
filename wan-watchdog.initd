#!/bin/sh /etc/rc.common
# /etc/init.d/wan-watchdog — procd wrapper
START=99
USE_PROCD=1

start_service() {
  procd_open_instance
  procd_set_param command /bin/sh /usr/bin/wan-watchdog
  procd_set_param respawn 3600 5 0
  procd_set_param stdout 0
  procd_set_param stderr 0
  procd_close_instance
}
